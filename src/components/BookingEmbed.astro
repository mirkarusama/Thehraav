---
/**
 * Cal ID booking widget.
 * Nothing from Cal ID loads until the visitor picks a session type (keeps the page fast and private).
 * A plain "open in a new tab" link is always shown as a fallback.
 */
import { site, isFilled } from '../config/site';
const b = site.booking;
const events = [
  { id: 'free', path: b.freeEvent },
  { id: 'regular', path: b.regularEvent },
].map((e) => ({ ...e, ready: isFilled(e.path) && !e.path.includes('['), url: `${b.base}/${e.path}` }));
---
<div class="booking" data-booking data-base={b.base}>
  {events.map((e) => (
    <template data-event={e.id} data-path={e.path} data-url={e.url} data-ready={String(e.ready)}></template>
  ))}
  <div class="frame-wrap" data-frame hidden>
    <p class="frame-status" data-status role="status">Loading the calendar…</p>
  </div>
  <p class="fallback small" data-fallback hidden>
    Calendar not showing? <a data-fallback-link href="#" target="_blank" rel="noopener">Open the booking page in a new tab</a>.
  </p>
  <p class="setup-note small" data-setup hidden>
    Booking calendar coming soon. Until then, please <a href="/contact">get in touch</a> and Sarah will find a time with you.
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-booking]');
  if (root) {
    const frameWrap = root.querySelector<HTMLElement>('[data-frame]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const fallback = root.querySelector<HTMLElement>('[data-fallback]')!;
    const fallbackLink = root.querySelector<HTMLAnchorElement>('[data-fallback-link]')!;
    const setup = root.querySelector<HTMLElement>('[data-setup]')!;

    const open = (id: string) => {
      const t = root.querySelector<HTMLTemplateElement>(`template[data-event="${id}"]`);
      if (!t) return;
      document.querySelectorAll<HTMLElement>('[data-choose]').forEach((btn) =>
        btn.setAttribute('aria-pressed', String(btn.dataset.choose === id)),
      );
      if (t.dataset.ready !== 'true') {
        frameWrap.hidden = true;
        fallback.hidden = true;
        setup.hidden = false;
        setup.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      setup.hidden = true;
      const url = t.dataset.url!;
      fallbackLink.href = url;
      fallback.hidden = false;
      frameWrap.hidden = false;
      frameWrap.querySelector('iframe')?.remove();
      status.hidden = false;
      const iframe = document.createElement('iframe');
      iframe.src = `${url}?embed=true&theme=light`;
      iframe.title = 'Choose a time for your session';
      iframe.loading = 'lazy';
      iframe.allow = 'payment';
      iframe.addEventListener('load', () => (status.hidden = true));
      frameWrap.appendChild(iframe);
      frameWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', `#${id}`);
    };

    document.querySelectorAll<HTMLElement>('[data-choose]').forEach((btn) =>
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        open(btn.dataset.choose!);
      }),
    );
    const initial = location.hash.slice(1);
    if (initial === 'free' || initial === 'regular') open(initial);
  }
</script>

<style>
  .frame-wrap {
    position: relative;
    margin-top: 2rem;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    min-height: 720px;
  }
  .frame-wrap[hidden] { display: none; }
  .frame-wrap :global(iframe) {
    display: block;
    width: 100%;
    height: 760px;
    border: 0;
  }
  .frame-status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    color: var(--ink-soft);
  }
  .fallback,
  .setup-note {
    margin-top: 1rem;
    text-align: center;
  }
  .setup-note {
    background: var(--rose);
    border-radius: var(--radius-sm);
    padding: 1rem 1.2rem;
    margin-top: 2rem;
  }
</style>
