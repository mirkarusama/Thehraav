---
// All footer text and links come from src/config/site.ts (site, footer).
import Logo from './Logo.astro';
import { site, footer, whatsappHref, socialLinks } from '../config/site';
const year = new Date().getFullYear(); // filled in at build time; see the script below for the live year
const socials = socialLinks();
---
<footer class="site-footer">
  <div class="container grid">
    <div class="brand">
      <a href="/" aria-label="Thehraav Counselling, home"><Logo /></a>
      <p class="tagline">{site.tagline}</p>
      {socials.length > 0 && (
        <ul class="socials" aria-label="Social media">
          {socials.map((s) => (
            <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-label="Footer">
      <h2 class="f-head">Quick links</h2>
      <ul class="links">
        {footer.quickLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="f-head">Get in touch</h2>
      <ul class="links">
        <li><a href={`mailto:${site.contact.email}`} class="break">{site.contact.email}</a></li>
        <li><a href={whatsappHref()} rel="noopener" target="_blank">Chat on WhatsApp</a></li>
      </ul>
      <p class="small muted">Sessions are online only.</p>
    </div>
  </div>

  <div class="container">
    <p class="emergency" role="note">
      <strong>{footer.emergency.heading}</strong>{' '}
      {footer.emergency.before} <a href={`tel:${site.emergency.number}`}>{site.emergency.line} on {site.emergency.number}</a>{' '}
      {footer.emergency.after}
    </p>
    <div class="legal">
      <p>© <span data-year>{year}</span> {footer.copyrightHolder}. All rights reserved.</p>
      <ul>
        {footer.legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<script>
  // Keep the copyright year current even if the site isn't rebuilt for a while.
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>

<style>
  .site-footer {
    background: var(--sand);
    padding-top: clamp(3rem, 7vw, 4.5rem);
    font-size: 1rem;
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
  }
  .grid {
    display: grid;
    gap: 2.2rem;
    grid-template-columns: 1fr;
    padding-bottom: 2.4rem;
  }
  @media (min-width: 44rem) {
    .grid { grid-template-columns: 1.4fr 1fr 1fr; }
  }
  .tagline {
    margin: 1rem 0 0;
    color: var(--ink-soft);
    max-width: 22rem;
  }
  .f-head {
    font-family: var(--font-sans);
    font-variation-settings: normal;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.9rem;
  }
  .links,
  .socials,
  .legal ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .links li + li { margin-top: 0.45rem; }
  .links a,
  .socials a,
  .legal a {
    color: var(--ink);
    text-decoration: none;
  }
  .links a:hover,
  .socials a:hover,
  .legal a:hover {
    color: var(--sage-deep);
    text-decoration: underline;
  }
  .break { overflow-wrap: anywhere; }
  .socials {
    display: flex;
    gap: 1.1rem;
    margin-top: 1rem;
    font-weight: 600;
  }
  .emergency {
    background: var(--white);
    border-left: 4px solid var(--terracotta);
    border-radius: var(--radius-sm);
    padding: 1rem 1.2rem;
    margin: 0 0 1.6rem;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    padding-block: 1.3rem 1.8rem;
    border-top: 1px solid var(--sand-deep);
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .legal p { margin: 0; }
  .legal ul { display: flex; gap: 1.2rem; }
</style>
