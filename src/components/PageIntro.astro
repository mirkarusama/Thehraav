---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-intro">
  <div class="container narrow">
    {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
    <h1 class="reveal" style="--d:1">{title}</h1>
    {lead && <p class="lead reveal" style="--d:3">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-intro {
    min-height: 52svh;
    display: grid;
    align-items: center;
    padding-block: clamp(3rem, 9vw, 6rem) clamp(2rem, 5vw, 3.5rem);
  }
  .page-intro h1 {
    font-size: clamp(2.6rem, 8.5vw, 5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .page-intro .lead {
    margin-bottom: 0;
  }
</style>
