---
// Decorative illustration: a calm dot resting above still-water ripples (echoes the logo mark).
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={`still-water ${cls}`} viewBox="0 0 400 480" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sw-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F3E7DC" />
      <stop offset="0.62" stop-color="#EBDDD0" />
      <stop offset="0.62" stop-color="#DCE4D8" />
      <stop offset="1" stop-color="#C9D5C6" />
    </linearGradient>
    <clipPath id="sw-arch">
      <path d="M0 200C0 89.5 89.5 0 200 0s200 89.5 200 200v280H0z" />
    </clipPath>
  </defs>
  <g clip-path="url(#sw-arch)">
    <rect width="400" height="480" fill="url(#sw-sky)" />
    <circle cx="200" cy="215" r="54" fill="#C98B72" opacity=".9" />
    <circle cx="200" cy="215" r="80" fill="#C98B72" opacity=".12" />
    <ellipse cx="200" cy="350" rx="70" ry="13" fill="none" stroke="#7D9180" stroke-width="3" />
    <ellipse cx="200" cy="352" rx="125" ry="25" fill="none" stroke="#7D9180" stroke-width="2.5" opacity=".6" />
    <ellipse cx="200" cy="356" rx="185" ry="40" fill="none" stroke="#7D9180" stroke-width="2" opacity=".35" />
    <rect y="297" width="400" height="2" fill="#FAF6F0" opacity=".5" />
  </g>
</svg>

<style>
  .still-water {
    width: 100%;
    height: auto;
  }
</style>
