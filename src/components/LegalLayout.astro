---
import Base from '../layouts/Base.astro';
import Val from './Val.astro';
import { site } from '../config/site';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <section class="section legal-page">
    <div class="container narrow">
      <p class="eyebrow reveal">Legal</p>
      <h1 class="reveal" style="--d:1">{title}</h1>
      <p class="muted">Last updated: <Val v={site.legalUpdated} /></p>
      {site.legalDraft && (
        <p class="note draft" role="note">
          <strong>Draft:</strong> this page is a plain-language starting point and should be reviewed (ideally by a
          lawyer familiar with India's Digital Personal Data Protection Act, 2023) before launch.
        </p>
      )}
      <div class="prose reveal" style="--d:2"><slot /></div>
    </div>
  </section>
</Base>

<style>
  .legal-page h1 { font-size: clamp(2rem, 5.6vw, 3rem); }
  .draft { margin-bottom: 2rem; }
  .prose :global(h2) { font-size: clamp(1.35rem, 3vw, 1.65rem); margin-top: 2.2rem; }
  .prose :global(li + li) { margin-top: 0.35rem; }
</style>
