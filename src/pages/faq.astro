---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Val from '../components/Val.astro';
import CancellationPolicy from '../components/CancellationPolicy.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { site } from '../config/site';
const s = site.sessions;
---
<Base
  title="FAQ: online counselling questions answered"
  description="Answers to common questions about online counselling with Thehraav: the first session, confidentiality, how online sessions work, languages, payment, cancellations and emergencies."
>
  <PageIntro eyebrow="FAQ" title="Questions, gently answered." />

  <section class="section section--tight">
    <div class="container narrow faq">
      <details class="reveal">
        <summary>What happens in the first session?</summary>
        <div class="answer">
          <p>
            We talk about what's been happening and what you'd like to change. You share only what you're ready to.
            It's free for new clients (<Val v={s.freeFirstLength} />).
          </p>
          <p>After booking, you'll get an email with a short consent form and intake form to fill in before we meet.</p>
        </div>
      </details>

      <details class="reveal">
        <summary>Is it confidential?</summary>
        <div class="answer">
          <p>
            Yes. What you share stays between us, within professional ethics and the law, for example if a life is at
            serious risk. The consent form explains this clearly. See also the <a href="/privacy">privacy policy</a>.
          </p>
        </div>
      </details>

      <details class="reveal">
        <summary>How do online sessions work?</summary>
        <div class="answer">
          <p>You'll get a private video link by email. Just click it at your session time.</p>
          <ul>
            <li>A quiet, private space</li>
            <li>Headphones, if you can</li>
            <li>A charged device and steady internet</li>
          </ul>
        </div>
      </details>

      <details class="reveal">
        <summary>Which languages?</summary>
        <div class="answer">
          <p>English and Hindi, or a mix of both, whatever feels natural.</p>
        </div>
      </details>

      <details class="reveal">
        <summary>How does payment work?</summary>
        <div class="answer">
          <p>
            Your first session is free. After that, sessions are <Val v={s.fee} />, paid securely through Razorpay
            (UPI, card or netbanking) when you book.
          </p>
        </div>
      </details>

      <details class="reveal">
        <summary>Can I cancel or reschedule?</summary>
        <div class="answer">
          <CancellationPolicy />
        </div>
      </details>

      <details class="reveal">
        <summary>Is this right for me?</summary>
        <div class="answer">
          <p>
            If anxiety or anger often feels like too much, and you'd like practical ways to feel steadier, it could be.
            You don't need to have it all figured out. Not sure? <a href="/contact">Ask me</a>, or book a free first
            session.
          </p>
        </div>
      </details>

      <details class="reveal">
        <summary>What if it's an emergency?</summary>
        <div class="answer">
          <p class="note">
            This website, email and WhatsApp are not for emergencies. If you're in crisis, please call
            <strong>Tele-MANAS on <a href="tel:14416">14416</a></strong> (free, 24/7), call
            <a href="tel:112">112</a>, or go to your nearest emergency service.
          </p>
        </div>
      </details>
    </div>
  </section>

  <ClosingCta title="Still wondering?" lead="Just ask. There's no wrong question." href="/contact" label="Get in touch" />
</Base>

<style>
  .faq details {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 0.9rem;
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    padding: 1.2rem 3.4rem 1.2rem 1.5rem;
    position: relative;
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(1.12rem, 2.4vw, 1.3rem);
    font-weight: 500;
    color: var(--sage-deep);
    line-height: 1.35;
    border-radius: var(--radius);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '';
    position: absolute;
    right: 1.4rem;
    top: 50%;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--terracotta);
    border-bottom: 2px solid var(--terracotta);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 0.25s;
  }
  .faq details[open] summary::after { transform: translateY(-30%) rotate(-135deg); }
  .answer { padding: 0 1.5rem 1.3rem; }
  .answer > :last-child { margin-bottom: 0; }
  .answer ul { margin: 0 0 1em; }
  .answer li + li { margin-top: 0.3rem; }
  /* Smooth open/close where supported */
  .faq details { interpolate-size: allow-keywords; }
  .faq details::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition: block-size 0.6s var(--ease-calm), opacity 0.6s var(--ease-calm), content-visibility 0.6s allow-discrete;
  }
  .faq details[open]::details-content { block-size: auto; opacity: 1; }
</style>
