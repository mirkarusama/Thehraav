---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { site, whatsappHref, isFilled } from '../config/site';
const formReady = isFilled(site.formspreeId);
const action = `https://formspree.io/f/${site.formspreeId}`;
---
<Base
  title="Contact"
  description="Get in touch with Thehraav Counselling by email, WhatsApp or a short message form. Online sessions for women in English and Hindi."
>
  <PageIntro
    eyebrow="Contact"
    title="Have a question? Just ask."
    lead="Whether you're unsure where to start or just want to know more, you're welcome to reach out. I'll get back to you as soon as I can."
  />

  <section class="section section--tight">
    <div class="container contact">
      <div class="ways">
        <div class="card way">
          <h2 class="h3">Email</h2>
          <p><a href={`mailto:${site.contact.email}`} class="break">{site.contact.email}</a></p>
        </div>
        <div class="card way">
          <h2 class="h3">WhatsApp</h2>
          <p>Prefer to chat? Send a message on WhatsApp.</p>
          <a class="btn btn--ghost" href={whatsappHref()} target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3Z"/></svg>
            Chat on WhatsApp
          </a>
        </div>
        <p class="note">
          <strong>Please don't use email, WhatsApp or this form in a crisis.</strong> If you need urgent help, call
          Tele-MANAS on <a href="tel:14416">14416</a> (free, 24/7) or your nearest emergency service.
        </p>
      </div>

      <div class="card form-card">
        <h2 class="h3">Send a message</h2>
        <form action={action} method="POST" data-contact-form>
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Your email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
            <p class="hint">A few lines is plenty. There's no need to share anything personal you're not comfortable with.</p>
          </div>
          <!-- spam trap: real people never see this -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
          <input type="hidden" name="_subject" value="New message from the Thehraav website" />
          <button class="btn" type="submit" disabled={!formReady}>Send message</button>
          {!formReady && <p class="hint">The form will work once the Formspree ID is added in <code>src/config/site.ts</code>.</p>}
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
          <p class="hint">Your message goes straight to Sarah's inbox. See the <a href="/privacy">privacy policy</a>.</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  // Send without leaving the page. Without JS the form still posts normally to Formspree.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !status) return;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'form-status';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error();
      form.reset();
      status.textContent = 'Thank you. Your message has been sent, and Sarah will reply soon.';
      status.classList.add('ok');
    } catch {
      status.textContent = 'Sorry, something went wrong. Please try again, or email directly.';
      status.classList.add('err');
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 1.6rem;
    align-items: start;
  }
  @media (min-width: 52rem) {
    .contact { grid-template-columns: 0.9fr 1.1fr; gap: 2.4rem; }
  }
  .ways { display: grid; gap: 1.2rem; }
  .way p:last-child { margin-bottom: 0; }
  .break { overflow-wrap: anywhere; font-weight: 600; }
  .note { margin: 0; }
  .h3 { font-size: clamp(1.25rem, 2.6vw, 1.45rem); font-weight: 520; }

  .field { margin-bottom: 1.2rem; }
  label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  input:not([type='hidden']),
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1.05rem;
    color: var(--ink);
    background: var(--cream);
    border: 1.5px solid #b9aa98;
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--sage-deep);
    box-shadow: 0 0 0 3px var(--sage-light);
  }
  textarea { resize: vertical; min-height: 8rem; }
  .hint {
    font-size: 0.92rem;
    color: var(--ink-soft);
    margin: 0.5rem 0 0;
  }
  .btn[disabled] { opacity: 0.55; cursor: not-allowed; }
  .form-status { margin: 1rem 0 0; font-weight: 600; }
  .form-status:empty { display: none; }
  .form-status.ok { color: var(--sage-deep); }
  .form-status.err { color: var(--terracotta-dark); }
</style>
