---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
---
<Base title="Page not found" description="This page couldn't be found." noindex>
  <section class="section">
    <div class="container narrow center">
      <p class="eyebrow reveal">Page not found</p>
      <h1 class="reveal" style="--d:1">Let's pause and find our way back.</h1>
      <p class="lead reveal" style="--d:2">This page isn't here.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--ghost" href="/">Go to the home page</a>
        <BookButton />
      </div>
    </div>
  </section>
</Base>
