---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ScrubText from '../components/ScrubText.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { site } from '../config/site';
const p = site.psychologist;
---
<Base
  title="About Sarah Shaikh, counselling psychologist"
  description="Sarah Shaikh is a counselling psychologist (M.A., Mumbai University; Diploma in CBT) offering warm, practical online counselling for women in English and Hindi."
>
  <PageIntro eyebrow="About" title="Hi, I'm Sarah." lead="Counselling psychologist. Here to help you find your steady." />

  <section class="section section--tight">
    <div class="container about">
      <div class="photo-wrap reveal">
        <img class="about-photo" src={p.photo} alt={p.photoAlt} width="640" height="800" decoding="async" />
      </div>
      <div class="about-text">
        <p class="big reveal">
          I work online with women who feel overwhelmed by anxiety, or by anger that's hard to control.
        </p>
        <p class="reveal" style="--d:1">My approach is warm, practical and free of judgement.</p>
        <p class="reveal" style="--d:2">
          Together, we'll understand your thoughts and reactions, and build calm, steady responses you can use in
          everyday life.
        </p>
      </div>
    </div>
  </section>

  <ScrubText lines={['Notice the thought.', 'Soften the reaction.', 'Choose a calmer response.']} height="230vh" />

  <section class="section">
    <div class="container narrow center">
      <p class="eyebrow reveal">My approach</p>
      <h2 class="reveal" style="--d:1">CBT, gently.</h2>
      <p class="lead reveal center-lead" style="--d:2">
        Cognitive Behavioural Therapy shows how your thoughts, feelings and actions connect. Then we practise small
        changes that help you feel calmer.
      </p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container facts" data-scrub="enter">
      <div class="fact reveal">
        <span class="dot" aria-hidden="true"></span>
        <h2 class="h3">Qualifications</h2>
        <ul>{p.qualifications.map((q) => <li>{q}</li>)}</ul>
      </div>
      <div class="fact reveal" style="--d:2">
        <span class="dot" aria-hidden="true"></span>
        <h2 class="h3">Languages</h2>
        <p>{p.languages.join(' and ')}, or a mix of both.</p>
      </div>
      <div class="fact reveal" style="--d:4">
        <span class="dot" aria-hidden="true"></span>
        <h2 class="h3">Online</h2>
        <p>Private video sessions, from wherever you feel safe.</p>
      </div>
    </div>
  </section>

  <ClosingCta />
</Base>

<style>
  .about {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 62rem;
  }
  @media (min-width: 48rem) {
    .about { grid-template-columns: 0.8fr 1.2fr; gap: 4.5rem; }
  }
  .photo-wrap { justify-self: center; width: 100%; max-width: 22rem; }
  .about-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px var(--radius) var(--radius);
    background: var(--sage-light);
  }
  .big {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(1.5rem, 3.6vw, 2.1rem);
    line-height: 1.35;
    color: var(--sage-deep);
  }
  .about-text p:not(.big) { color: var(--ink-soft); font-size: 1.15rem; }
  h2 { font-weight: 400; }
  .center-lead { margin-inline: auto; }

  /* Three facts joined by a line that draws as you scroll */
  .facts {
    position: relative;
    display: grid;
    gap: 2.6rem;
    max-width: 62rem;
  }
  .facts::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: linear-gradient(var(--sage), var(--terracotta));
    transform-origin: top;
    transform: scaleY(var(--p, 1));
  }
  .fact { position: relative; padding-left: 3.2rem; }
  .fact ul { list-style: none; padding: 0; margin: 0; }
  .fact p, .fact li { color: var(--ink-soft); margin: 0; }
  .h3 { font-size: clamp(1.4rem, 3vw, 1.75rem); margin-bottom: 0.4rem; }
  .dot {
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--cream);
    border: 2px solid var(--sage);
  }
  .fact:last-child .dot { background: var(--terracotta); border-color: var(--terracotta); }
  @media (min-width: 48rem) {
    .facts { grid-template-columns: repeat(3, 1fr); text-align: center; gap: 2rem; }
    .facts::before {
      left: 16%; right: 16%; top: 11px; bottom: auto; width: auto; height: 2px;
      background: linear-gradient(90deg, var(--sage), var(--terracotta));
      transform-origin: left;
      transform: scaleX(var(--p, 1));
    }
    .fact { padding-left: 0; padding-top: 3.2rem; }
    .dot { left: 50%; top: 0; margin-left: -12px; }
  }
</style>
