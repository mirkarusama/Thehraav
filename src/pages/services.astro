---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import PageIntro from '../components/PageIntro.astro';
import Val from '../components/Val.astro';
import CancellationPolicy from '../components/CancellationPolicy.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { site } from '../config/site';
const s = site.sessions;
---
<Base
  title="Services and fees: online counselling for anxiety and anger"
  description="One-to-one online counselling for women dealing with anxiety or anger, in English and Hindi. What support looks like, session fees, the free first session and the cancellation policy."
>
  <PageIntro eyebrow="Services" title="Support, one to one." lead="Private online sessions for women. In English or Hindi." />

  <section class="section section--tight">
    <div class="container areas">
      <article class="area reveal">
        <span class="area-mark" aria-hidden="true"></span>
        <h2>Anxiety</h2>
        <p class="area-lead">When worry takes over.</p>
        <ul>
          <li>Understand what sets it off</li>
          <li>Quiet anxious thoughts</li>
          <li>Tools to ground yourself, in the moment</li>
        </ul>
      </article>
      <article class="area reveal" style="--d:2">
        <span class="area-mark area-mark--warm" aria-hidden="true"></span>
        <h2>Anger</h2>
        <p class="area-lead">When it rises too fast.</p>
        <ul>
          <li>Notice the early signs</li>
          <li>Understand what sits beneath</li>
          <li>Pause, and respond your way</li>
        </ul>
      </article>
    </div>
    <p class="center muted reveal note-line">Practical, CBT-based, and at your pace.</p>
  </section>

  <section class="section section--sand" id="fees">
    <div class="container">
      <h2 class="center reveal">Sessions and fees</h2>
      <div class="fee-grid">
        <div class="card fee fee--free reveal" style="--d:1">
          <p class="tag">New clients</p>
          <h3>First session</h3>
          <p class="price">Free</p>
          <p class="meta"><Val v={s.freeFirstLength} /> · online</p>
          <p>Talk, ask questions, and see if we're a good fit.</p>
          <BookButton label="Book free session" href="/book#free" />
        </div>
        <div class="card fee reveal" style="--d:3">
          <p class="tag tag--sage">Ongoing</p>
          <h3>Individual session</h3>
          <p class="price"><Val v={s.fee} /></p>
          <p class="meta"><Val v={s.length} /> · online</p>
          <p>Pay securely with Razorpay when you book.</p>
          <BookButton label="Book a session" variant="ghost" href="/book#regular" />
        </div>
      </div>
      <p class="center small muted hours reveal">Available <Val v={s.hours} /></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="reveal">Cancellation policy</h2>
      <div class="reveal" style="--d:1"><CancellationPolicy /></div>
    </div>
  </section>

  <ClosingCta />
</Base>

<style>
  h2 { font-weight: 400; }
  .areas {
    display: grid;
    gap: 3rem;
    max-width: 62rem;
  }
  @media (min-width: 48rem) {
    .areas { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
  .area h2 { font-size: clamp(2.2rem, 6vw, 3.2rem); margin-bottom: 0.2rem; }
  .area-lead {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-style: italic;
    font-size: 1.3rem;
    color: var(--terracotta);
    margin-bottom: 1.2rem;
  }
  .area ul { list-style: none; padding: 0; margin: 0; }
  .area li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--sand-deep);
    color: var(--ink-soft);
  }
  .area-mark {
    display: block;
    width: 56px;
    height: 56px;
    margin-bottom: 1.2rem;
    border-radius: 50%;
    border: 1.5px solid var(--sage);
    box-shadow: inset 0 0 0 12px var(--cream), inset 0 0 0 40px var(--sage-light);
    animation: soft-pulse 8s ease-in-out infinite;
  }
  .area-mark--warm {
    border-color: var(--terracotta);
    box-shadow: inset 0 0 0 12px var(--cream), inset 0 0 0 40px var(--rose);
    animation-delay: -4s;
  }
  @keyframes soft-pulse {
    0%, 100% { transform: scale(0.94); }
    50% { transform: scale(1.06); }
  }
  .note-line { margin: 3rem 0 0; }

  .fee-grid {
    display: grid;
    gap: 1.2rem;
    margin: 2.4rem auto 0;
    max-width: 52rem;
  }
  @media (min-width: 44rem) {
    .fee-grid { grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  }
  .fee { display: flex; flex-direction: column; }
  .fee p:not(.tag, .price, .meta) { color: var(--ink-soft); }
  .fee .btn { margin-top: auto; align-self: flex-start; }
  .fee h3 { margin-bottom: 0.3rem; }
  .fee--free { outline: 2px solid var(--sage); outline-offset: -2px; }
  .tag {
    align-self: flex-start;
    background: var(--rose);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.2rem 0.8rem;
    margin-bottom: 1rem;
  }
  .tag--sage { background: var(--sage-light); color: var(--sage-deep); }
  .price {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 2.2rem;
    color: var(--sage-deep);
    margin: 0.2rem 0 0;
    line-height: 1.2;
  }
  .meta { color: var(--ink-soft); font-weight: 600; margin-bottom: 0.8rem; }
  .hours { margin: 2rem 0 0; }
</style>
