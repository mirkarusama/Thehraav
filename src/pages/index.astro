---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import ScrubText from '../components/ScrubText.astro';
import Breathe from '../components/Breathe.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { site } from '../config/site';
const p = site.psychologist;
---
<Base
  fullTitle
  title="Online counselling for women: anxiety and anger | Thehraav Counselling"
  description="Warm, practical, CBT-based online counselling for women who feel overwhelmed by anxiety or anger. Sessions in English and Hindi with Sarah Shaikh. Your first session is free."
>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow reveal">Online counselling for women</p>
      <h1 class="hero-title">
        <span class="reveal" style="--d:1">Find your</span>
        <span class="reveal" style="--d:3"><em>calm</em> again.</span>
      </h1>
      <p class="lead reveal" style="--d:5">Gentle support for anxiety and anger.<br />In English and Hindi.</p>
      <div class="btn-row reveal" style="--d:7">
        <BookButton />
      </div>
      <p class="small muted reveal" style="--d:8">First session free</p>
    </div>
    <a href="#feel" class="scroll-cue reveal" style="--d:10" aria-label="Scroll down">
      <span></span>
    </a>
  </section>

  <!-- 2. Feeling understood: words light up as you scroll -->
  <div id="feel">
    <ScrubText lines={["When worry won't switch off.", 'When anger rises too fast.', 'You deserve a pause.']} />
  </div>

  <!-- 3. The meaning of the name -->
  <section class="section meaning">
    <div class="container narrow center">
      <p class="devanagari reveal" lang="hi">ठहराव</p>
      <h2 class="reveal" style="--d:2">Thehraav means <em>a calm pause</em>.</h2>
      <p class="lead reveal" style="--d:4">A steady place to slow down, and begin again.</p>
    </div>
  </section>

  <!-- 4. Breathe -->
  <section class="section breathe-sec">
    <div class="container center">
      <div class="reveal"><Breathe /></div>
      <p class="muted reveal" style="--d:2">Take one slow breath with it. That's where we begin.</p>
    </div>
  </section>

  <!-- 5. How it works: a line draws through the steps -->
  <section class="section" id="how-it-works">
    <div class="container">
      <h2 class="center reveal">Three gentle steps</h2>
      <ol class="steps" data-scrub="enter">
        <li class="reveal" style="--d:1">
          <span class="dot" aria-hidden="true"></span>
          <h3>Book</h3>
          <p>Pick a time. Two minutes.</p>
        </li>
        <li class="reveal" style="--d:3">
          <span class="dot" aria-hidden="true"></span>
          <h3>Meet online</h3>
          <p>A private video call, from home.</p>
        </li>
        <li class="reveal" style="--d:5">
          <span class="dot" aria-hidden="true"></span>
          <h3>Feel steadier</h3>
          <p>Practical tools for everyday life.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 6. Meet Sarah -->
  <section class="section">
    <div class="container meet">
      <div class="photo-wrap reveal">
        <img class="meet-photo" src={p.photo} alt={p.photoAlt} width="640" height="800" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="eyebrow reveal">Your counsellor</p>
        <h2 class="reveal" style="--d:1">Hi, I'm Sarah.</h2>
        <p class="lead reveal" style="--d:2">Warm, practical, and free of judgement.</p>
        <ul class="creds reveal" style="--d:3">
          <li>M.A. Counselling Psychology, Mumbai University</li>
          <li>Diploma in CBT</li>
          <li>English and Hindi</li>
        </ul>
        <a href="/about" class="text-link reveal" style="--d:4">More about me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <ClosingCta />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: calc(100svh - 4.5rem);
    display: grid;
    align-items: center;
    padding-block: 3rem 5rem;
  }
  .hero-title {
    font-size: clamp(3rem, 11vw, 6.6rem);
    line-height: 1.02;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin-bottom: 1.4rem;
  }
  .hero-title span {
    display: block;
  }
  .hero-title em,
  .meaning em {
    color: var(--terracotta);
  }
  .hero .lead {
    margin-bottom: 2rem;
  }
  .hero .small {
    margin: 0.9rem 0 0;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    margin-left: -13px;
    width: 26px;
    height: 42px;
    border: 1.5px solid var(--sage);
    border-radius: 999px;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 4px;
    background: var(--sage-deep);
    animation: cue 2.6s var(--ease-calm) infinite;
  }
  @keyframes cue {
    0% { transform: translateY(0); opacity: 0; }
    30% { opacity: 1; }
    80%, 100% { transform: translateY(14px); opacity: 0; }
  }

  /* Meaning */
  .devanagari {
    font-size: clamp(3.5rem, 14vw, 7rem);
    line-height: 1.2;
    color: var(--sage);
    margin-bottom: 0.6rem;
    font-family: 'Noto Serif Devanagari', 'Tiro Devanagari Hindi', serif;
  }
  .meaning h2 {
    font-size: clamp(1.9rem, 5.4vw, 3rem);
    font-weight: 400;
  }
  .meaning .lead {
    margin-inline: auto;
  }

  .breathe-sec p {
    margin-top: 2rem;
  }

  /* Steps with a drawn connecting line */
  .steps {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 3rem auto 0;
    max-width: 60rem;
    display: grid;
    gap: 2.6rem;
  }
  .steps::before {
    /* the line: vertical on mobile, horizontal on desktop */
    content: '';
    position: absolute;
    left: 11px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: linear-gradient(var(--sage), var(--terracotta));
    transform-origin: top;
    transform: scaleY(var(--p, 1));
    border-radius: 2px;
  }
  .steps li {
    position: relative;
    padding-left: 3.2rem;
  }
  .steps h3 {
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-weight: 420;
    margin-bottom: 0.3rem;
  }
  .steps p {
    margin: 0;
    color: var(--ink-soft);
  }
  .dot {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--cream);
    border: 2px solid var(--sage);
    box-shadow: 0 0 0 6px var(--cream);
  }
  .steps li:last-child .dot {
    border-color: var(--terracotta);
    background: var(--terracotta);
  }
  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      text-align: center;
    }
    .steps::before {
      left: 16%;
      right: 16%;
      top: 11px;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--sage), var(--terracotta));
      transform-origin: left;
      transform: scaleX(var(--p, 1));
    }
    .steps li {
      padding-left: 0;
      padding-top: 3.2rem;
    }
    .dot {
      left: 50%;
      top: 0;
      margin-left: -12px;
    }
  }

  /* Meet Sarah */
  .meet {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 60rem;
  }
  @media (min-width: 48rem) {
    .meet { grid-template-columns: 0.85fr 1.15fr; gap: 4.5rem; }
  }
  .photo-wrap {
    justify-self: center;
    width: 100%;
    max-width: 22rem;
  }
  .meet-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px var(--radius) var(--radius);
    background: var(--sage-light);
  }
  .meet h2 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 400;
    margin-bottom: 0.4rem;
  }
  .creds {
    list-style: none;
    padding: 0;
    margin: 0 0 1.6rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .creds li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--sand-deep);
  }
  .text-link {
    display: inline-block;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--terracotta);
    padding-bottom: 2px;
  }

</style>
