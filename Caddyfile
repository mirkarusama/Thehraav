# Tiny static file server for the built site (dist/).
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Clean URLs: /about -> about.html
	try_files {path} {path}.html {path}/index.html

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Hashed build assets and fonts never change: cache for a year.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else (HTML, logo, images): short cache so edits show up quickly.
	@other not path /_astro/*
	header @other Cache-Control "public, max-age=3600"

	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
